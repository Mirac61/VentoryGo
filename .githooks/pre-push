#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)/backend"

if [ -f .env ]; then
  set -a; source .env; set +a
fi

unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "nicht formatiert:"
  echo "$unformatted"
  exit 1
fi

go vet ./...

if [ -n "${TEST_DATABASE_URL:-}" ]; then
  go test ./... -race
else
  echo "TEST_DATABASE_URL nicht gesetzt — nur -short Tests"
  go test -short ./... -race
fi
