#!/usr/bin/env bash
set -euo pipefail

# A tip commit whose subject starts with "wip" pushes an unfinished state through.
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  subject=$(git log -1 --format=%s "$local_sha")
  if [[ "${subject,,}" == wip* ]]; then
    echo "wip-Commit (\"$subject\") — Pruefungen uebersprungen"
    exit 0
  fi
done

cd "$(git rev-parse --show-toplevel)/backend"

if [ -f .env ]; then
  set -a; source .env; set +a
fi

unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "nicht formatiert:"
  echo "$unformatted"
  exit 1
fi

go vet ./...

if [ -n "${TEST_DATABASE_URL:-}" ]; then
  go test ./... -race
else
  echo "TEST_DATABASE_URL nicht gesetzt — nur -short Tests"
  go test -short ./... -race
fi
