# Kopieren nach .env. Ohne diese Datei startet Compose nicht.
# Das Passwort darf Sonderzeichen enthalten. Unquoted ignoriert Compose Leerzeichen
# am Rand; ein Leerzeichen gefolgt von # startet einen Kommentar. Werte mit
# Leerzeichen/# in einfache Anführungszeichen setzen: $ bleibt erhalten, ein
# Apostroph wird als \' geschrieben. Beispiel: POSTGRES_PASSWORD='hello #world $HOME let\'s'
# Dasselbe Passwort in backend/.env in den URL-Variablen prozent-kodieren.
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoice_db
