# Kopieren nach backend/.env, Passwort passend zu ../.env setzen.
# Gilt fuer `go run .` und `go test ./...` auf dem Host, daher localhost.
# Die Postgres-Zugangsdaten fuer den Container stehen in ../.env.example.
DATABASE_URL=postgres://invoice_user:PASSWORT@localhost:5432/invoice_db?sslmode=disable
# Muss eine eigene Datenbank sein — die Tests löschen Zeilen. Leer lassen heißt:
# die Tests fallen auf DATABASE_URL zurück und räumen die Entwicklungs-DB leer.
TEST_DATABASE_URL=postgres://invoice_user:PASSWORT@localhost:5432/invoice_test?sslmode=disable

# Optional, sonst greifen die Defaults aus internal/invoice/numbering.go
# INVOICE_NUMBER_PREFIX=RE
# INVOICE_TIMEZONE=Europe/Berlin

# Das Session-Cookie wird ohne diese Zeile nur ueber HTTPS gesetzt, sonst
# verwirft der Browser es. Fuer `go run .` auf http://localhost einkommentieren.
# In Produktion nur, wenn die App bewusst ohne TLS laeuft.
# COOKIE_SECURE=false
